{
  "schema_version": "0.1",
  "purpose": "Evidence-aware physical-industry capability and dependency representation",
  "node_types": [
    "final_product",
    "subsystem",
    "component",
    "material",
    "process",
    "machine_tool",
    "facility",
    "resource",
    "standard",
    "organization",
    "policy",
    "logistics_node",
    "energy_node"
  ],
  "node_required_fields": {
    "id": "stable internal identifier",
    "name": "human-readable name",
    "type": "node type",
    "geography": "country/region/site or UNKNOWN",
    "status": "no_capability|emerging|demonstrated|producing_licensed|producing_own_tech|competitive|unknown",
    "capacity": "quantity, unit, period, and confidence; nullable",
    "utilization": "fraction and date; nullable",
    "yield": "fraction or distribution and evidence; nullable",
    "quality_or_tolerance": "specification and evidence; nullable",
    "qualification_state": "not_started|study|rd|prototype|testing|certification|limited_production|qualified|unknown",
    "lead_time": "calendar duration plus percentile/confidence; nullable",
    "capex": "amount, currency, scope, date, and confidence; nullable",
    "opex": "amount, currency, unit basis, date, and confidence; nullable",
    "energy_intensity": "energy per unit and boundary; nullable",
    "water_and_waste": "quantities and boundary; nullable",
    "ownership_or_ip": "public|licensed|proprietary|unknown",
    "export_control": "jurisdiction and restriction state; nullable",
    "evidence": "one or more source records with quote/claim, access date, and epistemic label"
  },
  "edge_types": {
    "depends_on": "required input or prerequisite",
    "unlocks": "downstream capability enabled by node",
    "transforms": "process converts input to output",
    "supplied_by": "organization or geography supplies node",
    "located_at": "node linked to facility or region",
    "qualified_by": "standard/customer/process qualification relationship",
    "substitutes_for": "alternative with explicit tradeoffs and conditions",
    "constrained_by": "policy, resource, energy, logistics, or quality constraint",
    "financed_by": "investor/policy funding relationship",
    "transports_through": "logistics path relationship"
  },
  "dynamic_variables": [
    "inventory_buffer_days",
    "single_source_ratio",
    "supplier_concentration_hhi",
    "substitution_elasticity",
    "qualification_latency",
    "ramp_rate",
    "learning_curve_progress_ratio",
    "stochastic_downtime",
    "power_available",
    "specific_energy",
    "permitting_latency",
    "trade_restriction_state",
    "recovery_time_objective"
  ],
  "evidence_labels": ["FACT", "DERIVED_INTERPRETATION", "MODEL_ESTIMATE", "UNCERTAIN_CLAIM", "UNKNOWN"],
  "minimum_provenance": ["source_url", "publisher", "publication_or_update_date", "access_date", "claim_or_measure", "geographic_scope", "temporal_scope", "license_or_access", "limitations", "confidence"]
}
